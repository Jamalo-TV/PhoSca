DATABASE_URL=postgresql+asyncpg://digitizer:digitizer_password@postgres:5432/digitizer
REDIS_URL=redis://redis:6379/0
STORAGE_PATH=/app/storage
HOST_STORAGE_PATH=/absolute/path/to/PhoSca/storage
PIPELINE_VERSION=2026-11-precise-crops-v32
MAX_UPLOAD_SIZE=52428800
MAX_REQUEST_SIZE=209715200
BLUR_THRESHOLD=100.0
YOLO_CONFIDENCE_THRESHOLD=0.7
YOLO_PROPOSAL_THRESHOLD=0.25
YOLO_MODEL_PATH=/app/models/yolov8-seg-album.onnx
# VISIBLE_MASK_MODEL_PATH=/app/models/local-mask-v4.onnx
MODEL_MANIFEST_PATH=/app/models/manifest.json
REQUIRE_REGISTERED_MODELS=true
SEGMENTATION_CALIBRATION_PATH=/app/models/segmentation-calibration.json
REQUIRE_CONFIDENCE_CALIBRATION=true
CROP_VALIDATION_REPORT_PATH=/app/models/crop-validation.json
# CAMERA_CALIBRATION_PATH=/app/models/camera-calibrations.json
ENABLE_PHOTO_ORIENTATION_CORRECTION=true
PHOTO_ORIENTATION_MODEL_PATH=/app/models/photo-orientation.onnx
PADDLEOCR_MODEL_PATH=/app/models/paddleocr/
PADDLEOCR_LANGUAGE=en
ENABLE_LLM_FALLBACK=false
LLM_MODEL_PATH=/app/models/llava-phi3/
LOG_LEVEL=INFO
CELERY_TASK_ALWAYS_EAGER=false
ENABLE_CLASSICAL_SEGMENTATION_FALLBACK=true
ENABLE_PRECISE_PHOTO_CROPS=true
ENABLE_BORDER_TRIM=true
ENABLE_PROTECTED_REGION_GUARD=true
ENABLE_CONSERVATIVE_ENHANCEMENT=true
ENABLE_DEEP_ENHANCEMENT=false
ENABLE_PREMIUM_ENHANCEMENT=false
RETENTION_DERIVATIVE_DAYS=30
RETENTION_DLQ_DAYS=14
SHADOW_MODE=true
CANARY_PERCENTAGE=0
RELEASE_KILL_SWITCH=true
AUTO_ANALYZE_UPLOADS=true
POSTGRES_USER=digitizer
POSTGRES_PASSWORD=digitizer_password
POSTGRES_DB=digitizer
